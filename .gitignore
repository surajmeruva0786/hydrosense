# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
notebooks/.tmp_nb*/

# Environment / secrets
.env
.env.*

# Data (raw audio is licensed / not redistributable; processed artifacts are large)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep
data/splits/*.csv
!data/splits/.gitkeep

# Training outputs
runs/*
!runs/.gitkeep
results/*
!results/.gitkeep
*.ckpt
*.pt
*.pth
*.h5
*.keras

# Logs
*.log
logs/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Streamlit
.streamlit/secrets.toml
